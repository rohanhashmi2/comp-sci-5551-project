# Copy this file to .env and fill in your own values.
# Never commit .env — it is in .gitignore.

# --- Django ---
# Generate a fresh key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Supabase (used by runserver, migrate, manage.py) ---
# Paste YOUR OWN Supabase session-pooler URI. Find it in:
#   Supabase dashboard
#     → your project
#     → Project Settings
#       → Database
#         → Connection string
#           → Session pooler
#             → URI
# The host will look like aws-0-<region>.pooler.supabase.com on port 5432.
# Keep the ?sslmode=require query parameter at the end.
DATABASE_URL=postgres://postgres.<your-project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Local Postgres (used by pytest only) ---
# See README section B for how to install Postgres locally and create the
# inspectiq_dev database. Match the major version to your Supabase project.
# Note: .env is not shell-expanded — write your literal username, not $USER.
#   macOS / Linux example:   postgres://alice@localhost:5432/inspectiq_dev
#   Windows (EDB installer): postgres://postgres:<install-password>@localhost:5432/inspectiq_dev
TEST_DATABASE_URL=postgres://<your-local-user>@localhost:5432/inspectiq_dev
